{
  "redirects": [
    {
      "source": "/servicios",
      "destination": "/precios",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/((?!api/|alquiler|precios|assets/|robots.txt|sitemap.xml).*)",
      "destination": "/index.html"
    }
  ]
}
